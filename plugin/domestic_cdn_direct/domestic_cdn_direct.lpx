#!name = 国内 CDN 与直连优化
#!desc = 为已确认的国内网站指定阿里 DoH 并强制 DIRECT，改善 CDN 调度；不包含节点或订阅信息。
#!author = Phinsin666
#!homepage = https://github.com/Phinsin666/Phinsinrules
#!system = iOS,iPadOS,macOS
#!date = 2026-11-26
#!type = normal

[Host]
