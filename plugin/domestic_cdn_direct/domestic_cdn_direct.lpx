#!name = 国内 CDN 与直连优化
#!desc = 为已确认的国内网站指定阿里 DoH 并强制 DIRECT，改善 CDN 调度；不包含节点或订阅信息。
#!author = Phinsin666
#!homepage = https://github.com/Phinsin666/Phinsinrules
#!system = iOS,iPadOS,macOS
#!date = 2026-11-18
#!type = normal

[Host]
# 国内加密 DNS；根域名与所有子域名均覆盖。
115.com = server:https://dns.alidns.com/dns-query
*.115.com = server:https://dns.alidns.com/dns-query
115cdn.com = server:https://dns.alidns.com/dns-query
